# SAGE Environment Configuration
# Copy to .env and adjust values. Never commit .env.

SAGE_ENV=development
SAGE_DATA_DIR=./data
SAGE_LOG_LEVEL=INFO
SAGE_LOG_FORMAT=console

# Database
SAGE_DB_PATH=./data/sage.db

# AI Model providers (optional — leave blank for offline stub mode)
# SAGE_OPENAI_API_KEY=
# SAGE_ANTHROPIC_API_KEY=
# SAGE_DEFAULT_MODEL_PROVIDER=stub
# SAGE_DEFAULT_MODEL_NAME=stub-v1

# Server (Phase 4)
# SAGE_API_HOST=127.0.0.1
# SAGE_API_PORT=8742
