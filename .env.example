# SAGE Environment Configuration
# Copy to .env and adjust values. Never commit .env.

SAGE_ENV=development
SAGE_DATA_DIR=./data
SAGE_LOG_LEVEL=INFO
SAGE_LOG_FORMAT=console

# Database
SAGE_DB_PATH=./data/sage.db

# AI Model providers (optional — leave blank for offline stub mode)
# SAGE_OPENAI_API_KEY=
# SAGE_ANTHROPIC_API_KEY=
# SAGE_DEFAULT_MODEL_PROVIDER=stub
# SAGE_DEFAULT_MODEL_NAME=stub-v1

# Embeddings — the TurboVec slot (stub | hashing | local)
# "hashing" = deterministic offline similarity, no server needed
# "local"   = OpenAI-compatible embeddings endpoint (Ollama /v1, llama.cpp, vLLM)
# SAGE_MODELS__EMBEDDING_PROVIDER=stub
# SAGE_MODELS__EMBEDDING_MODEL_NAME=nomic-embed-text
# SAGE_MODELS__EMBEDDING_DIM=256

# Server (Phase 4)
# SAGE_API_HOST=127.0.0.1
# SAGE_API_PORT=8742

